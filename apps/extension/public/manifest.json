{
  "manifest_version": 3,
  "name": "Note App Extension",
  "version": "1.0.0",
  "description": "Quick notes for Note App",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:3000/*"
  ]
}
