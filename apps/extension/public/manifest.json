{
  "manifest_version": 3,
  "name": "TNote Extension",
  "version": "1.0.0",
  "description": "Quick notes for TNote App",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://tnote-web.vercel.app/*",
    "https://tnote.onrender.com/*"
  ]
}
